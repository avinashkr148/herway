# Copy this file to .env, then fill in the values from Supabase Dashboard → Project Settings → API.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# URL used in shared trip links. For local web development, this can be the web-tracker URL.
EXPO_PUBLIC_TRACKER_URL=http://localhost:3000
